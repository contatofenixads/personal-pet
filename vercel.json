{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "personal-pet.vercel.app" }],
      "destination": "https://personal-pet-exemplo.vercel.app/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    }
  ]
}
